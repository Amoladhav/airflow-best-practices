APP_ENV=dev

# Compose namespace: airflow-dev.
# Compose will use this to isolate containers, networks, and named volumes.
COMPOSE_PROJECT_NAME=airflow-dev

# Host port fow the deveopment API/UI: 8081.
# Test and prod will later use 8082 and 8083.
AIRFLOW_PORT=8081
SALES_INPUT_DIR=./data/dev/input

# Airflow header, browser title and navigation color.
AIRFLOW_UI_NAME="Sales Lab | DEV"
AIRFLOW_UI_THEME='{"tokens":{"colors":{"brand":{"50":{"value":"oklch(0.97 0.014 250)"},"100":{"value":"oklch(0.94 0.032 250)"},"200":{"value":"oklch(0.88 0.06 250)"},"300":{"value":"oklch(0.81 0.1 250)"},"400":{"value":"oklch(0.71 0.14 250)"},"500":{"value":"oklch(0.64 0.16 250)"},"600":{"value":"oklch(0.56 0.15 250)"},"700":{"value":"oklch(0.48 0.13 250)"},"800":{"value":"oklch(0.42 0.11 250)"},"900":{"value":"oklch(0.37 0.085 250)"},"950":{"value":"oklch(0.26 0.055 250)"}}}}}'
