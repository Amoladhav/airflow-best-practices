APP_ENV=prod

# Compose namespace: airflow-prod.
# Compose will use this to isolate containers, networks, and named volumes.
COMPOSE_PROJECT_NAME=airflow-prod

# Host port fow the prod API/UI: 8083.
# Dev and test will use 8081 and 8082.
AIRFLOW_PORT=8083
SALES_INPUT_DIR=./data/prod/input

# Airflow header, browser title and navigation color.
AIRFLOW_UI_NAME="Sales Lab | PROD"
AIRFLOW_UI_THEME='{"tokens":{"colors":{"brand":{"50":{"value":"oklch(0.97 0.014 25)"},"100":{"value":"oklch(0.94 0.032 25)"},"200":{"value":"oklch(0.88 0.06 25)"},"300":{"value":"oklch(0.81 0.1 25)"},"400":{"value":"oklch(0.71 0.14 25)"},"500":{"value":"oklch(0.64 0.16 25)"},"600":{"value":"oklch(0.56 0.15 25)"},"700":{"value":"oklch(0.48 0.13 25)"},"800":{"value":"oklch(0.42 0.11 25)"},"900":{"value":"oklch(0.37 0.085 25)"},"950":{"value":"oklch(0.26 0.055 25)"}}}}}'
