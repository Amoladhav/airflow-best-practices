APP_ENV=test

# Compose namespace: airflow-test.
# Compose will use this to isolate containers, networks, and named volumes.
COMPOSE_PROJECT_NAME=airflow-test

# Host port fow the test API/UI: 8082.
# Dev and prod will use 8081 and 8083.
AIRFLOW_PORT=8082
SALES_INPUT_DIR=./data/test/input

# Airflow header, browser title and navigation color.
AIRFLOW_UI_NAME="Sales Lab | TEST"
AIRFLOW_UI_THEME='{"tokens":{"colors":{"brand":{"50":{"value":"oklch(0.97 0.014 75)"},"100":{"value":"oklch(0.94 0.032 75)"},"200":{"value":"oklch(0.88 0.06 75)"},"300":{"value":"oklch(0.81 0.1 75)"},"400":{"value":"oklch(0.71 0.14 75)"},"500":{"value":"oklch(0.64 0.16 75)"},"600":{"value":"oklch(0.56 0.15 75)"},"700":{"value":"oklch(0.48 0.13 75)"},"800":{"value":"oklch(0.42 0.11 75)"},"900":{"value":"oklch(0.37 0.085 75)"},"950":{"value":"oklch(0.26 0.055 75)"}}}}}'
